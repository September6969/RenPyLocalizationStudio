<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RenPyLocalizationStudio.Core\RenPyLocalizationStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RenPyLocalizationStudio</AssemblyName>
    <RootNamespace>RenPyLocalizationStudio.App</RootNamespace>
    <!-- 默认采用框架依赖发布：目标电脑需安装 .NET 10 Desktop Runtime。 -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.2.1</Version>
    <Product>RenPy Localization Studio</Product>
    <Description>面向 Ren’Py 项目的本地化、剧情流编辑与补丁工作台。</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgSkiaSharp_NativeAssets_Win32)\THIRD-PARTY-NOTICES.txt"
          Link="licenses\SkiaSharp-THIRD-PARTY-NOTICES.txt"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(PkgSkiaSharp_NativeAssets_Win32)\THIRD-PARTY-NOTICES.txt')" />
  </ItemGroup>

</Project>
