<Application x:Class="RenPyLocalizationStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="StudioTextFontFamily">pack://application:,,,/RenPyLocalizationStudio;component/Assets/Fonts/#LXGW WenKai</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/StudioTheme.xaml" />
                <ResourceDictionary Source="Themes/WorkspaceTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
