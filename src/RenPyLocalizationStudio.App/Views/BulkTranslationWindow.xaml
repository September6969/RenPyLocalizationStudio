<Window x:Class="RenPyLocalizationStudio.App.Views.BulkTranslationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="批量复用译文" Width="1000" Height="650" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource BackgroundLevel1}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}" />
  <Style x:Key="PreviewCellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/><Setter Property="Padding" Value="4,5"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel>
   <TextBlock Text="默认范围：打开窗口时的视图与筛选结果" VerticalAlignment="Center" Margin="0,0,16,8"/>
   <CheckBox Content="整个项目当前语言" IsChecked="{Binding EntireProject}" Margin="0,0,12,8"/>
   <Button Content="刷新预览" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/>
   <Button Content="取消计算" Command="{Binding CancelCommand}" Margin="0,0,0,8"/>
  </WrapPanel>
  <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,12"/>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
    RowHeight="32" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="{DynamicResource BackgroundLevel1}" RowBackground="{DynamicResource BackgroundLevel1}"
    Foreground="{DynamicResource TextPrimaryBrush}" HeadersVisibility="Column" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="采用" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Center"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="原文" Binding="{Binding Original}" IsReadOnly="True" Width="2*" MinWidth="170" ElementStyle="{StaticResource PreviewCellText}"/>
    <DataGridTextColumn Header="拟采用译文" Binding="{Binding Translation}" IsReadOnly="True" Width="2*" MinWidth="170" ElementStyle="{StaticResource PreviewCellText}"/>
    <DataGridTextColumn Header="状态 / 跳过原因" Binding="{Binding Status}" IsReadOnly="True" Width="160" ElementStyle="{StaticResource PreviewCellText}"/>
   </DataGrid.Columns>
  </DataGrid>
  <ScrollViewer Grid.Row="3" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
   <StackPanel DataContext="{Binding SelectedRow}">
    <TextBlock Text="{Binding Original, StringFormat=原文：{0}}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Translation, StringFormat=译文：{0}}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding Source, StringFormat=来源：{0}}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding Location, StringFormat=影响位置：{0}}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Style="{StaticResource PrimaryButtonStyle}" Content="应用勾选项" Command="{Binding ApplyCommand}" Padding="16,8" Margin="0,0,12,0"/>
   <Button Content="关闭" Click="Close_Click" Padding="16,8"/>
  </StackPanel>
 </Grid>
</Window>
