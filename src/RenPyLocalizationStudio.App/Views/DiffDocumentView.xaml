<UserControl x:Class="RenPyLocalizationStudio.App.Views.DiffDocumentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:behaviors="clr-namespace:RenPyLocalizationStudio.App.Behaviors">
    <Grid Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="补丁差异" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="应用补丁" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="原文件  −" Foreground="{DynamicResource SemanticErrorBrush}"/><avalonEdit:TextEditor Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True" WordWrap="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" behaviors:AvalonEditBindingBehavior.BindableText="{Binding OriginalText, Mode=OneWay}"/></Grid>
            <Border Grid.Column="1" Background="{DynamicResource BackgroundLevel2}"/>
            <Grid Grid.Column="2" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="更新后  +" Foreground="{DynamicResource SemanticSuccessBrush}"/><avalonEdit:TextEditor Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True" WordWrap="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" behaviors:AvalonEditBindingBehavior.BindableText="{Binding UpdatedText, Mode=OneWay}"/></Grid>
        </Grid>
    </Grid>
</UserControl>
