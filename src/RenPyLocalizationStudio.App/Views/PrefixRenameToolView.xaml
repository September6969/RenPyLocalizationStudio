<UserControl x:Class="RenPyLocalizationStudio.App.Views.PrefixRenameToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="生成预览" Command="{Binding PlanCommand}" Style="{StaticResource GhostButtonStyle}"/>
                <Button Content="执行重命名" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="项目内目录" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/><TextBox Margin="0,5,0,0" Text="{Binding RelativeDirectory, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="移除前缀" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/><TextBox Margin="0,5,0,0" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <CheckBox Grid.Column="3" Margin="18,20,0,0" Content="递归子目录" IsChecked="{Binding Recursive}"/>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource BrandAccentBrush}"/>
            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" Text="冲突项不会执行"/>
        </DockPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  Background="Transparent" BorderThickness="0" GridLinesVisibility="None" EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="原文件" Binding="{Binding Source}" Width="2*"/>
                <DataGridTextColumn Header="目标文件" Binding="{Binding Target}" Width="2*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
