<UserControl x:Class="RenPyLocalizationStudio.App.Views.ZzzDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:behaviors="clr-namespace:RenPyLocalizationStudio.App.Behaviors">
    <Grid Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="zzz.rpy 向导" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="生成 Diff" Command="{Binding PreviewCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></DockPanel>
        <StackPanel Grid.Row="1" Margin="0,14,0,10"><CheckBox Content="默认语言" IsChecked="{Binding IncludeDefaultLanguage}"/><CheckBox Content="设置页语言入口" IsChecked="{Binding IncludePreferences}" Margin="0,8,0,0"/><TextBox Text="{Binding NativeLanguageName}" Margin="22,4,0,0" ToolTip="语言显示名称"/></StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10"><CheckBox Content="字体覆盖" IsChecked="{Binding IncludeFont}"/><TextBox Text="{Binding FontPath}" Margin="22,4,0,0" ToolTip="项目内字体路径"/></StackPanel>
        <Grid Grid.Row="3" Margin="0,8,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="自定义补丁代码" FontWeight="SemiBold"/>
                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="8" Background="{DynamicResource BrandAccentSoftBrush}">
                    <TextBlock Text="Ren’Py / Python" FontSize="11" Foreground="{DynamicResource BrandAccentBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Tab 缩进  ·  Shift+Tab 减少缩进  ·  Ctrl+Space 补全  ·  Ctrl+/ 注释"
                       FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="补全" Click="CompletionButton_Click" Style="{StaticResource GhostButtonStyle}"
                    Padding="10,5" MinHeight="28" Margin="8,0,0,0" Focusable="False" IsTabStop="False"
                    ToolTip="打开 Ren’Py / Python 补全（Ctrl+Space）"/>
        </Grid>
        <Border Grid.Row="4" Background="{DynamicResource CodeEditorSurfaceBrush}"
                BorderBrush="{DynamicResource CodeEditorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1">
            <avalonEdit:TextEditor x:Name="CodeEditor" ShowLineNumbers="True" SyntaxHighlighting="Python"
                                   FontFamily="Cascadia Code, Cascadia Mono, Consolas" FontSize="12"
                                   Background="Transparent" Foreground="{DynamicResource DialogueTextBrush}"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   behaviors:AvalonEditBindingBehavior.BindableText="{Binding CustomCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   behaviors:AvalonEditBindingBehavior.DocumentKey="zzz-custom-code"
                                   behaviors:RenPyCodeEditorBehavior.IsEnabled="True" />
        </Border>
    </Grid>
</UserControl>
