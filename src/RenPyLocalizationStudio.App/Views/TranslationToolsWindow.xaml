<Window x:Class="RenPyLocalizationStudio.App.Views.TranslationToolsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="翻译校对工具" Width="1100" Height="760" MinWidth="720" MinHeight="550" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource BackgroundLevel1}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}"><Setter Property="Margin" Value="0,2,8,2"/><Setter Property="Padding" Value="12,6"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="RowHeight" Value="32"/><Setter Property="Background" Value="{DynamicResource BackgroundLevel1}"/><Setter Property="RowBackground" Value="{DynamicResource BackgroundLevel1}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/><Setter Property="Padding" Value="4,5"/></Style>
 </Window.Resources>
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TabControl x:Name="Tabs" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}">
  <TabItem Header="项目术语表"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="维护人名、地名和专有名词。禁用译名以英文分号分隔；检查结果只提示，不自动改写。" TextWrapping="Wrap" Margin="0,8"/>
   <DataGrid x:Name="TermsGrid" Grid.Row="1" ItemsSource="{Binding Terms}" CanUserAddRows="True" CanUserDeleteRows="True">
    <DataGrid.Columns><DataGridTextColumn Header="原文术语" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="140"/><DataGridTextColumn Header="推荐译名" Binding="{Binding Preferred, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="140"/><DataGridTextColumn Header="禁用译名（; 分隔）" Binding="{Binding Forbidden, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="160"/><DataGridCheckBoxColumn Header="区分大小写" Binding="{Binding CaseSensitive}" Width="110"/></DataGrid.Columns>
   </DataGrid><Button Grid.Row="2" Content="保存术语表" Click="SaveTerms_Click" HorizontalAlignment="Left"/>
  </Grid></TabItem>
  <TabItem Header="校对状态与备注"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid ItemsSource="{Binding Workspace.VisibleItems}" SelectedItem="{Binding Workspace.SelectedItem}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="原文 / 条目" Binding="{Binding BodyText}" Width="2*" MinWidth="240" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="位置 / 说明" Binding="{Binding Subtitle}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid>
   <StackPanel Grid.Row="1" Margin="0,8"><TextBlock Text="{Binding Workspace.Inspector.TranslationText}" TextWrapping="Wrap" MaxHeight="100"/><TextBlock Text="{Binding Workspace.Inspector.EditorialHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSubtleBrush}"/></StackPanel>
   <WrapPanel Grid.Row="2"><ComboBox Width="130" ItemsSource="{Binding ReviewStatuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedReviewStatus}"/><TextBlock Text="译文修改后自动回到待校对" Margin="12,4"/></WrapPanel>
   <StackPanel Grid.Row="3"><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" ToolTip="校对备注" Margin="0,8"/><Button Content="保存校对状态与备注" Command="{Binding SaveNoteCommand}" IsEnabled="{Binding Workspace.CanReviewSelection}" HorizontalAlignment="Left"/></StackPanel>
  </Grid></TabItem>
  <TabItem Header="替换 / 校对表 / 迁移"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <WrapPanel><ComboBox Width="150" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/><CheckBox Content="整个项目当前语言" IsChecked="{Binding WholeProject}" Margin="12,5"/><Button Content="导出当前语言校对表" Click="Export_Click"/><Button Content="选择校对表 CSV" Click="Import_Click"/><Button Content="取消计算" Command="{Binding CancelCommand}"/></WrapPanel>
   <TextBlock Grid.Row="1" Text="{Binding CsvName}" TextTrimming="CharacterEllipsis" Margin="0,6"/>
   <WrapPanel Grid.Row="2" Margin="0,0,0,8"><TextBlock Text="查找译文" VerticalAlignment="Center"/><TextBox Width="180" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/><TextBlock Text="替换为" VerticalAlignment="Center"/><TextBox Width="180" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/><CheckBox Content="区分大小写" IsChecked="{Binding CaseSensitive}" Margin="0,5,8,0"/><CheckBox Content="正则" IsChecked="{Binding Regex}" Margin="0,5,8,0"/><Button Content="生成预览" Command="{Binding PreviewCommand}"/></WrapPanel>
   <DataGrid Grid.Row="3" ItemsSource="{Binding PreviewRows}" SelectedItem="{Binding SelectedPreview}" CanUserDeleteRows="False"><DataGrid.Columns>
    <DataGridTemplateColumn Header="采用" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="原文" Binding="{Binding Original}" IsReadOnly="True" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="当前译文" Binding="{Binding Before}" IsReadOnly="True" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="拟采用译文" Binding="{Binding Translation}" IsReadOnly="True" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="180" ElementStyle="{StaticResource CellText}"/>
   </DataGrid.Columns></DataGrid>
   <ScrollViewer Grid.Row="4" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8"><StackPanel DataContext="{Binding SelectedPreview}"><TextBlock Text="{Binding Original, StringFormat=原文：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Before, StringFormat=当前：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Translation, StringFormat=拟采用：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Source, StringFormat=来源：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Location, StringFormat=影响位置：{0}}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
   <Button Grid.Row="5" Content="应用勾选项" Command="{Binding ApplyCommand}" HorizontalAlignment="Right"/>
  </Grid></TabItem>
  <TabItem Header="外部修改对比"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <WrapPanel><Button Content="读取磁盘并对比" Command="{Binding CompareCommand}"/><Button Content="取消计算" Command="{Binding CancelCommand}"/><TextBlock Text="应用仅更新内存与保存基线；保留本地修改后仍需保存。" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
   <DataGrid Grid.Row="1" ItemsSource="{Binding MergeRows}" SelectedItem="{Binding SelectedMerge}" CanUserDeleteRows="False"><DataGrid.Columns>
    <DataGridTemplateColumn Header="取舍" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Choice, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="原文" Binding="{Binding Original}" IsReadOnly="True" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="本地译文" Binding="{Binding Local}" IsReadOnly="True" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="磁盘译文" Binding="{Binding Disk}" IsReadOnly="True" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="说明" Binding="{Binding Reason}" IsReadOnly="True" Width="180" ElementStyle="{StaticResource CellText}"/>
   </DataGrid.Columns></DataGrid>
   <ScrollViewer Grid.Row="2" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,8"><StackPanel DataContext="{Binding SelectedMerge}"><TextBlock Text="{Binding Original, StringFormat=原文：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Baseline, StringFormat=原始基线：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Local, StringFormat=本地：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Disk, StringFormat=磁盘：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/><TextBlock Text="{Binding Location, StringFormat=影响位置：{0}}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
   <Button Grid.Row="3" Content="采用选定版本并更新基线" Command="{Binding ApplyMergeCommand}" HorizontalAlignment="Right"/>
  </Grid></TabItem>
 </TabControl>
 <DockPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="关闭" Click="Close_Click" DockPanel.Dock="Right"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
