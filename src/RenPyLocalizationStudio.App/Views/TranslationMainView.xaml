<UserControl x:Class="RenPyLocalizationStudio.App.Views.TranslationMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:RenPyLocalizationStudio.App.Behaviors"
             xmlns:vm="clr-namespace:RenPyLocalizationStudio.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar Header -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundLevel1}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BackgroundLevel2}">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Workspace.ViewTitle}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Workspace.ItemCount}" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0"
                                Visibility="{Binding Workspace.HasCoverage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Width="80" Height="4" Margin="0,0,12,0" VerticalAlignment="Center" BorderThickness="0"
                                     Background="{DynamicResource BackgroundLevel2}" Foreground="{DynamicResource BrandAccentBrush}"
                                     AutomationProperties.Name="当前投影翻译覆盖率"
                                     Maximum="100" Value="{Binding Workspace.CoveragePercent, Mode=OneWay}" />
                        <TextBlock Text="{Binding Workspace.CoverageText}" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="清除筛选" Command="{Binding Workspace.ClearSearchCommand}" Style="{StaticResource GhostButtonStyle}" Padding="12,6" />
                    <Button Content="定位原代码" Command="{Binding Workspace.NavigateBookmarkCommand}"
                            CommandParameter="{Binding Workspace.SelectedItem}" Style="{StaticResource GhostButtonStyle}"
                            Padding="12,6" Margin="8,0,0,0" ToolTip="从书签回到原始剧情流中的代码行"
                            Visibility="{Binding Workspace.IsBookmarkView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="打开检查器" Command="{Binding Workspace.ToggleInspectorCommand}" Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vertical Split: Upper Flow List, Middle GridSplitter, Lower Image Preview -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Upper Row: Code/Dialogue Flow List -->
                <RowDefinition Height="3*" MinHeight="140" />
                <!-- Middle Row: Draggable GridSplitter -->
                <RowDefinition Height="Auto" />
                <!-- Lower Row: Game Image Preview Panel -->
                <RowDefinition Height="2*" MinHeight="110" />
            </Grid.RowDefinitions>

            <!-- Upper: Flow List -->
            <ListView x:Name="FlowList" Grid.Row="0" ItemsSource="{Binding Workspace.VisibleItems}" SelectedItem="{Binding Workspace.SelectedItem}"
                      behaviors:ScrollAnchorBehavior.AnchorItem="{Binding Workspace.AnchorItem}"
                      PreviewMouseLeftButtonUp="FlowList_PreviewMouseLeftButtonUp" PreviewMouseDoubleClick="FlowList_PreviewMouseDoubleClick"
                      PreviewMouseRightButtonDown="FlowList_PreviewMouseRightButtonDown"
                      PreviewKeyDown="FlowList_PreviewKeyDown"
                      Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ContentRowStyle}"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowSurface" Background="Transparent" CornerRadius="6" Padding="12,8"
                                Tag="{Binding DataContext.Workspace, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="添加书签"
                                              Style="{StaticResource StudioMenuItemStyle}"
                                              Template="{StaticResource StudioMenuItemTemplate}"
                                              Visibility="{Binding IsBookmarked, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                              Command="{Binding PlacementTarget.Tag.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="移除书签"
                                              Style="{StaticResource StudioMenuItemStyle}"
                                              Template="{StaticResource StudioMenuItemTemplate}"
                                              Visibility="{Binding IsBookmarked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Command="{Binding PlacementTarget.Tag.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="跳转到原代码行"
                                              Style="{StaticResource StudioMenuItemStyle}"
                                              Template="{StaticResource StudioMenuItemTemplate}"
                                              Visibility="{Binding PlacementTarget.Tag.IsBookmarkView, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Command="{Binding PlacementTarget.Tag.NavigateBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border x:Name="AccentLine" Width="3" CornerRadius="1.5" Margin="0,2,12,2" Background="{Binding Accent}" Opacity="0.4" />
                                <StackPanel Grid.Column="1" Margin="{Binding IndentMargin}" VerticalAlignment="Center">
                                    <TextBlock x:Name="DialogueLine" TextWrapping="Wrap" Visibility="Collapsed" FontSize="14">
                                        <Run Text="{Binding SpeakerPrefix, Mode=OneWay}" Foreground="{DynamicResource SpeakerTextBrush}"
                                             FontFamily="{StaticResource StudioUiFontFamily}" FontWeight="Medium" />
                                        <Run Text="{Binding BodyText, Mode=OneWay}" Foreground="{DynamicResource DialogueTextBrush}"
                                             FontFamily="{StaticResource StudioReadingFontFamily}" FontWeight="Normal" />
                                    </TextBlock>
                                    <TextBlock x:Name="StructureLine" Text="{Binding BodyText}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource DialogueTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Subtitle}" Margin="0,3,0,0" FontSize="11"
                                               Foreground="{DynamicResource PathTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                
                                <TextBlock Grid.Column="2" Text="●" FontSize="10" Margin="10,0,2,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrandAccentBrush}" ToolTip="已添加书签"
                                           Visibility="{Binding IsBookmarked, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- Badges -->
                                <Border x:Name="StatusBadge" Grid.Column="3" Margin="16,0,4,0" Padding="8,3" CornerRadius="4"
                                        VerticalAlignment="Center" Background="{DynamicResource BackgroundLevel1}"
                                        Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Pending}"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Unbound}"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Missing}"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Dynamic}"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Conflict}"><Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Error}"><Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDialogue}" Value="True">
                                <Setter TargetName="DialogueLine" Property="Visibility" Value="Visible" />
                                <Setter TargetName="StructureLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLabel}" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource LabelSurfaceBrush}" />
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource BackgroundLevel1}" />
                                <Setter TargetName="RowSurface" Property="Margin" Value="0,10,0,4" />
                                <Setter TargetName="RowSurface" Property="Padding" Value="8,6" />
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Middle: Draggable GridSplitter -->
            <GridSplitter Grid.Row="1" Style="{StaticResource RowGridSplitterStyle}" />

            <!-- Lower: Game Image Preview Panel -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundLevel1}" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BackgroundLevel2}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header Bar -->
                    <Border Background="{DynamicResource BackgroundLevel1}" Padding="12,0" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource BackgroundLevel2}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                           Foreground="{DynamicResource BrandAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="游戏画面预览" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Scene statement badge -->
                            <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,2" CornerRadius="4"
                                    Background="{DynamicResource BrandAccentSoftBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding Workspace.ImagePreview.HasImages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding Workspace.ImagePreview.SelectedImage.RelativePath}">
                                <TextBlock Text="{Binding Workspace.ImagePreview.SceneTag}" FontSize="11"
                                           Foreground="{DynamicResource BrandAccentBrush}" FontWeight="Medium" />
                            </Border>

                            <!-- Multi-image selector tabs (Background vs Sprites) -->
                            <ListBox Grid.Column="2" ItemsSource="{Binding Workspace.ImagePreview.AvailableImages}"
                                     SelectedItem="{Binding Workspace.ImagePreview.SelectedImage}"
                                     ItemContainerStyle="{StaticResource PreviewTabItemStyle}"
                                     Background="Transparent" BorderThickness="0" Margin="10,0,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding Workspace.ImagePreview.HasMultipleImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kind}" FontSize="11" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Right actions & details -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BackgroundLevel2}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Visibility="{Binding Workspace.ImagePreview.HasImages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="{Binding Workspace.ImagePreview.SelectedImage.RelativePath}">
                                    <TextBlock Text="{Binding Workspace.ImagePreview.SelectedImageDetails}" FontSize="11"
                                               Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                                </Border>
                                <Button Content="打开所在目录" Command="{Binding Workspace.ImagePreview.OpenLocationCommand}"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,3" MinHeight="22" FontSize="11"
                                        ToolTip="在 Windows 资源管理器中定位此素材图片" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Image Display Area -->
                    <Grid Grid.Row="1" Background="{DynamicResource BackgroundLevel0}">
                        <!-- Loaded Image -->
                        <Image Source="{Binding Workspace.ImagePreview.CurrentBitmap}" Stretch="Uniform"
                               AutomationProperties.Name="当前剧情图片预览"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Workspace.ImagePreview.HasImages, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Empty / Placeholder State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.6"
                                    Visibility="{Binding Workspace.ImagePreview.HasImages, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons" FontSize="32"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSubtleBrush}" />
                            <TextBlock Text="{Binding Workspace.ImagePreview.StatusHint}" Margin="0,8,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
