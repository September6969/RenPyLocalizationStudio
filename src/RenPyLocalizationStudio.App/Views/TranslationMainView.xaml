<UserControl x:Class="RenPyLocalizationStudio.App.Views.TranslationMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:RenPyLocalizationStudio.App.Behaviors"
             xmlns:vm="clr-namespace:RenPyLocalizationStudio.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 常用操作始终可见；低频操作与筛选集中到弹出菜单。 -->
        <Border x:Name="ToolbarBorder" Grid.Row="0" Background="{DynamicResource BackgroundLevel1}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}">
            <Grid x:Name="ToolbarGrid" Margin="12,8" SizeChanged="Toolbar_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentedTrackBorderStyle}" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=ViewSegments}"><ListBox x:Name="ViewSegments" ItemsSource="{Binding Workspace.ViewModes}" SelectedItem="{Binding Workspace.ViewMode}" ItemTemplate="{StaticResource ViewModeLabelTemplate}" ItemContainerStyle="{StaticResource SegmentedItemStyle}" AutomationProperties.Name="翻译视图" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></Border>
                    <ComboBox x:Name="CompactViewSelector" Width="100" Visibility="Collapsed" ItemsSource="{Binding Workspace.ViewModes}" SelectedItem="{Binding Workspace.ViewMode}" ItemTemplate="{StaticResource ViewModeLabelTemplate}" AutomationProperties.Name="翻译视图"/>
                    <Border Grid.Column="1" Background="{DynamicResource BackgroundLevel0}" BorderThickness="1" CornerRadius="6" Margin="8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Workspace.SearchText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown" Style="{StaticResource BoxedTextBoxStyle}" Background="Transparent" BorderThickness="0" Padding="2,5" ToolTip="Ctrl+F 搜索；Esc 清除关键词" AutomationProperties.Name="搜索剧情流"/>
                            <TextBlock Grid.Column="1" Text="搜索 · Ctrl+F" IsHitTestVisible="False" Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <StackPanel x:Name="InlineSearchOptions" Grid.Column="2" Orientation="Horizontal"><ToggleButton Content="Aa" IsChecked="{Binding Workspace.SearchCaseSensitive}" Style="{StaticResource IconToggleStyle}" Padding="5,4" ToolTip="区分大小写" AutomationProperties.Name="搜索区分大小写"/><ToggleButton Content=".*" IsChecked="{Binding Workspace.SearchRegex}" Style="{StaticResource IconToggleStyle}" Padding="5,4" ToolTip="正则表达式" AutomationProperties.Name="正则搜索"/></StackPanel>
                        </Grid>
                    </Border>
                    <ToggleButton x:Name="FilterToggle" Grid.Column="2" Style="{StaticResource IconToggleStyle}" ToolTip="筛选与搜索选项" AutomationProperties.Name="筛选与搜索选项"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons"/><TextBlock x:Name="FilterLabel" Text=" 筛选"/><Border Background="{DynamicResource BrandAccentSoftBrush}" CornerRadius="6" Margin="4,0,0,0" Padding="4,0" Visibility="{Binding Workspace.HasScopeFilters, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding Workspace.ActiveFilterCount}"/></Border></StackPanel></ToggleButton>
                    <Popup x:Name="FilterPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=FilterToggle}" IsOpen="{Binding IsChecked, ElementName=FilterToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Style="{StaticResource FlyoutBorderStyle}" Width="288"><StackPanel>
                        <TextBlock Text="搜索字段" Style="{StaticResource CaptionTextStyle}"/><ComboBox ItemsSource="{Binding Workspace.SearchFields}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Workspace.SearchField}" AutomationProperties.Name="搜索字段" Margin="0,4,0,8"/>
                        <WrapPanel><CheckBox Content="区分大小写" IsChecked="{Binding Workspace.SearchCaseSensitive}" Margin="0,0,12,0"/><CheckBox Content="正则" IsChecked="{Binding Workspace.SearchRegex}"/></WrapPanel>
                        <TextBlock Text="校对状态" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Workspace.ReviewFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Workspace.ReviewFilter}" AutomationProperties.Name="校对状态筛选"/>
                        <TextBlock Text="译文状态" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Workspace.StatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Workspace.StatusFilter}" AutomationProperties.Name="译文状态筛选"/>
                        <TextBlock Text="文件 / Label 范围" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Workspace.ProgressScopes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Workspace.SelectedScope}" AutomationProperties.Name="文件或Label进度范围" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel></ComboBox>
                        <Button Content="清除全部筛选" Command="{Binding Workspace.ClearSearchCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </StackPanel></Border></Popup>
                </Grid>
                <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding Workspace.MoveNextPendingCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" ToolTip="F8 · 下一条待译" AutomationProperties.Name="下一条待译"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons"/><TextBlock x:Name="NextLabel" Text=" 下一条待译"/></StackPanel></Button>
                        <Button x:Name="RefreshButton" Content="刷新结果" Command="{Binding Workspace.RefreshResultsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="4,0" Visibility="{Binding Workspace.NeedsResultsRefresh, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Click="Bulk_Click" IsEnabled="{Binding Workspace.CanOpenBulk}" Style="{StaticResource GhostButtonStyle}" Padding="8,5" ToolTip="批量复用" AutomationProperties.Name="批量复用"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons"/><TextBlock x:Name="BulkLabel" Text=" 批量复用"/></StackPanel></Button>
                        <Button Click="Editorial_Click" Tag="0" IsEnabled="{Binding Workspace.CanOpenBulk}" Style="{StaticResource GhostButtonStyle}" Padding="8,5" ToolTip="术语与校对" AutomationProperties.Name="术语与校对"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D2;" FontFamily="Segoe Fluent Icons"/><TextBlock x:Name="EditorialLabel" Text=" 术语与校对"/></StackPanel></Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Padding="8,5" Click="More_Click" ToolTip="更多翻译操作" AutomationProperties.Name="更多翻译操作"><TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons"/><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="查找替换 / 回填 / 迁移" Click="Editorial_Click" Tag="2" IsEnabled="{Binding Workspace.CanOpenBulk}"/><MenuItem Header="外部修改对比" Click="Editorial_Click" Tag="3" IsEnabled="{Binding Workspace.CanOpenBulk}"/><MenuItem Header="撤销批量编辑" Command="{Binding Workspace.UndoBulkCommand}"/><Separator/>
                            <MenuItem Header="定位原代码" Command="{Binding Workspace.NavigateBookmarkCommand}" CommandParameter="{Binding Workspace.SelectedItem}" Visibility="{Binding Workspace.IsBookmarkView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <MenuItem Header="清除筛选" Command="{Binding Workspace.ClearSearchCommand}"/>
                        </ContextMenu></Button.ContextMenu></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CoveragePanel" Background="{DynamicResource BackgroundLevel0}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="8,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Workspace.ItemCount}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/><ProgressBar Width="54" Height="4" VerticalAlignment="Center" BorderThickness="0" Maximum="100" Value="{Binding Workspace.CoveragePercent, Mode=OneWay}" ToolTip="{Binding Workspace.CoverageText}" Foreground="{DynamicResource BrandAccentBrush}" Background="{DynamicResource BackgroundLevel2}" AutomationProperties.Name="当前投影翻译覆盖率"/><TextBlock Text="{Binding Workspace.CoverageText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Border>
                        <Button Command="{Binding Workspace.ToggleInspectorCommand}" Content="&#xE89F;" FontFamily="Segoe Fluent Icons" Style="{StaticResource GhostButtonStyle}" Padding="8,5" ToolTip="{Binding Workspace.InspectorToggleText}" AutomationProperties.Name="{Binding Workspace.InspectorToggleText}"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource InfoBarStyle}" Margin="0,8,0,0" Visibility="{Binding Workspace.HasInfoMessage, Converter={StaticResource BooleanToVisibilityConverter}}"><DockPanel>
                    <Button DockPanel.Dock="Right" Content="取消计算" Command="{Binding Workspace.CancelResultsCommand}" Style="{StaticResource GhostButtonStyle}" Padding="6,0" Visibility="{Binding Workspace.IsComputing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Workspace.InfoMessage}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}"/>
                </DockPanel></Border>
            </Grid>
        </Border>

        <!-- Vertical Split: Upper Flow List, Middle GridSplitter, Lower Image Preview -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Upper Row: Code/Dialogue Flow List -->
                <RowDefinition x:Name="FlowRow" Height="3*" MinHeight="140" />
                <!-- Middle Row: Draggable GridSplitter -->
                <RowDefinition Height="Auto" />
                <!-- Lower Row: Game Image Preview Panel -->
                <RowDefinition x:Name="PreviewRow" Height="2*" MinHeight="110" />
            </Grid.RowDefinitions>

            <!-- Upper: Flow List -->
            <ListView x:Name="FlowList" Grid.Row="0" ItemsSource="{Binding Workspace.VisibleItems}" SelectedItem="{Binding Workspace.SelectedItem}"
                      behaviors:ScrollAnchorBehavior.AnchorItem="{Binding Workspace.AnchorItem}"
                      PreviewMouseLeftButtonUp="FlowList_PreviewMouseLeftButtonUp" PreviewMouseDoubleClick="FlowList_PreviewMouseDoubleClick"
                      PreviewMouseRightButtonDown="FlowList_PreviewMouseRightButtonDown"
                      PreviewKeyDown="FlowList_PreviewKeyDown"
                      Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ContentRowStyle}"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowSurface" Background="Transparent" CornerRadius="6" Padding="12,8"
                                Tag="{Binding DataContext.Workspace, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="添加书签"
                                              Style="{StaticResource StudioMenuItemStyle}"
                                              Template="{StaticResource StudioMenuItemTemplate}"
                                              Visibility="{Binding IsBookmarked, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                              Command="{Binding PlacementTarget.Tag.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="移除书签"
                                              Style="{StaticResource StudioMenuItemStyle}"
                                              Template="{StaticResource StudioMenuItemTemplate}"
                                              Visibility="{Binding IsBookmarked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Command="{Binding PlacementTarget.Tag.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="跳转到原代码行"
                                              Style="{StaticResource StudioMenuItemStyle}"
                                              Template="{StaticResource StudioMenuItemTemplate}"
                                              Visibility="{Binding PlacementTarget.Tag.IsBookmarkView, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Command="{Binding PlacementTarget.Tag.NavigateBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border x:Name="AccentLine" Width="3" CornerRadius="1.5" Margin="0,2,12,2" Background="{Binding Accent}" Opacity="0.4" />
                                <StackPanel Grid.Column="1" Margin="{Binding IndentMargin}" VerticalAlignment="Center">
                                    <StackPanel x:Name="DialogueLine" Visibility="Collapsed">
                                        <Border Background="{DynamicResource BackgroundLevel2}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="7,1.5" HorizontalAlignment="Left" Margin="0,0,0,4"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding SpeakerText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding SpeakerText}" FontWeight="SemiBold" Foreground="{DynamicResource BrandAccentHoverBrush}" FontSize="{StaticResource FontSizeCaption}"/></Border>
                                        <TextBlock Text="{Binding BodyText}" TextWrapping="Wrap" Foreground="{DynamicResource DialogueTextBrush}" FontFamily="{StaticResource StudioReadingFontFamily}" FontSize="{StaticResource FontSizeBodyLarge}"/>
                                        <TextBlock Text="{Binding TranslatedPreview}" TextWrapping="Wrap" Margin="0,3,0,1" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource StudioReadingFontFamily}" FontSize="{StaticResource FontSizeBody}" Visibility="{Binding HasTranslatedPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StructureLine" Text="{Binding BodyText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{DynamicResource DialogueTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" Margin="0,3,0,0" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource PathTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                
                                <TextBlock Grid.Column="2" Text="&#xE8A4;" FontFamily="Segoe Fluent Icons" FontSize="{StaticResource FontSizeCaption}" Margin="10,0,2,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrandAccentBrush}" ToolTip="已添加书签"
                                           Visibility="{Binding IsBookmarked, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- Badges -->
                                <Border x:Name="StatusBadge" Grid.Column="3" Margin="16,0,4,0" Padding="8,3" CornerRadius="4"
                                        VerticalAlignment="Center" Background="{DynamicResource BackgroundLevel1}"
                                        Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Pending}"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Unbound}"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Missing}"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Dynamic}"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Conflict}"><Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Error}"><Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"><Setter TargetName="AccentLine" Property="Opacity" Value="1"/><Setter TargetName="AccentLine" Property="Background" Value="{DynamicResource BrandAccentBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsDialogue}" Value="True">
                                <Setter TargetName="DialogueLine" Property="Visibility" Value="Visible" />
                                <Setter TargetName="StructureLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLabel}" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource LabelSurfaceBrush}" />
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource BackgroundLevel1}" />
                                <Setter TargetName="RowSurface" Property="Margin" Value="0,10,0,4" />
                                <Setter TargetName="RowSurface" Property="Padding" Value="8,6" />
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Pending}"><Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SemanticWarningSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Unbound}"><Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SemanticWarningSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Missing}"><Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SemanticWarningSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Dynamic}"><Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SemanticWarningSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Conflict}"><Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SemanticErrorSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static vm:TranslationStatusKind.Error}"><Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SemanticErrorSoftBrush}"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 按当前视图说明空列表的原因，并提供恢复入口。 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        MaxWidth="420" Visibility="{Binding Workspace.IsListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Workspace.EmptyStateTitle}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Workspace.EmptyStateHint}" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,8,0,12" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="清除筛选" Command="{Binding Workspace.ClearSearchCommand}" HorizontalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding Workspace.HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Middle: Draggable GridSplitter -->
            <GridSplitter x:Name="PreviewSplitter" DragCompleted="PreviewSplitter_DragCompleted" Grid.Row="1" Style="{StaticResource RowGridSplitterStyle}" />

            <!-- Lower: Game Image Preview Panel -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundLevel1}" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header Bar -->
                    <Border Background="{DynamicResource BackgroundLevel1}" Padding="12,0" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource BorderSubtleBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource BrandAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="游戏画面预览" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <StackPanel MaxWidth="420">
                                            <TextBlock Text="{Binding Workspace.ImagePreview.SceneTag}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Workspace.ImagePreview.SelectedImage.RelativePath}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Workspace.ImagePreview.SelectedImageDetails}" />
                                        </StackPanel>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>

                            <!-- Multi-image selector tabs (Background vs Sprites) -->
                            <ListBox Grid.Column="2" ItemsSource="{Binding Workspace.ImagePreview.AvailableImages}"
                                     SelectedItem="{Binding Workspace.ImagePreview.SelectedImage}"
                                     ItemContainerStyle="{StaticResource PreviewTabItemStyle}"
                                     Background="Transparent" BorderThickness="0" Margin="10,0,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding Workspace.ImagePreview.HasMultipleImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kind}" FontSize="{StaticResource FontSizeCaption}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Right actions & details -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="PreviewCollapseToggle" Style="{StaticResource IconToggleStyle}" IsChecked="{Binding Workspace.ImagePreview.IsCollapsed, Mode=TwoWay}"
                                              Checked="PreviewCollapse_Changed" Unchecked="PreviewCollapse_Changed"
                                              Padding="8,3" Margin="0,0,8,0" ToolTip="收起画面预览，为剧情列表腾出空间"
                                              AutomationProperties.Name="收起或展开画面预览">
                                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="收起预览" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Workspace.ImagePreview.IsCollapsed}" Value="True">
                                            <Setter Property="Text" Value="展开预览" />
                                        </DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style></TextBlock>
                                </ToggleButton>
                                <Button Content="&#xE8B7;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="打开图片所在目录" Command="{Binding Workspace.ImagePreview.OpenLocationCommand}"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,3" MinHeight="22" FontSize="{StaticResource FontSizeCaption}"
                                        ToolTip="在 Windows 资源管理器中定位此素材图片" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Image Display Area -->
                    <Grid Grid.Row="1" Background="{DynamicResource BackgroundLevel0}"
                          Visibility="{Binding Workspace.ImagePreview.IsCollapsed, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <!-- Loaded Image -->
                        <Image Source="{Binding Workspace.ImagePreview.CurrentBitmap}" Stretch="Uniform"
                               AutomationProperties.Name="当前剧情图片预览"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Workspace.ImagePreview.HasImages, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Empty / Placeholder State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.6" Margin="20"
                                    Visibility="{Binding Workspace.ImagePreview.HasImages, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons" FontSize="32"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSubtleBrush}" />
                            <TextBlock Text="{Binding Workspace.ImagePreview.StatusHint}" Margin="0,8,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
