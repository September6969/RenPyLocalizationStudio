<UserControl x:Class="RenPyLocalizationStudio.App.Views.TlMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,12,18,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Workspace.PageTitle}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Workspace.PageDescription}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Workspace.PageDescription}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel x:Name="OptionsActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="执行预检" Command="{Binding Workspace.PreflightCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="生成翻译文件" Command="{Binding Workspace.GenerateCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.IsOptionsPage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            </StackPanel>
            <StackPanel x:Name="LogActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{Binding Workspace.LogCountText}" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="清空日志" Command="{Binding Workspace.ClearLogsCommand}" Style="{StaticResource GhostButtonStyle}"/>
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.IsHistoryPage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            </StackPanel>
        </Grid>

        <Grid x:Name="OptionsPage" Grid.Row="1" Margin="0,22,0,0">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.IsOptionsPage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="目标语言" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="与 Ren’Py Launcher 一致，使用小写 ASCII 语言目录名。" Margin="0,4,0,12" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap"/>
                <TextBox Text="{Binding Workspace.TargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" FontSize="16" Padding="8,8" ToolTip="例如 schinese、japanese、portuguese_br"/>
                <TextBlock Text="{Binding Workspace.LanguageHint}" Margin="2,7,0,22" FontSize="11" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.IsLanguageValid}" Value="False"><Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="生成内容" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <CheckBox IsChecked="{Binding Workspace.Empty}" Margin="0,0,0,12"><StackPanel Margin="7,0,0,0"><TextBlock Text="为空译文生成空字符串"/><TextBlock Text="Ren’Py Launcher 默认选项  ·  --empty" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/></StackPanel></CheckBox>
                <CheckBox IsChecked="{Binding Workspace.StringsOnly}" Margin="0,0,0,12"><StackPanel Margin="7,0,0,0"><TextBlock Text="仅生成字符串翻译"/><TextBlock Text="跳过对白 translate 块  ·  --strings-only" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/></StackPanel></CheckBox>
                <CheckBox IsChecked="{Binding Workspace.NoTodo}"><StackPanel Margin="7,0,0,0"><TextBlock Text="不写入 TODO 标记"/><TextBlock Text="保持生成文件更简洁  ·  --no-todo" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/></StackPanel></CheckBox>
            </StackPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource BackgroundLevel1}" CornerRadius="4" Padding="14,12">
                    <StackPanel>
                        <DockPanel><TextBlock Text="执行计划" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="官方 SDK" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BrandAccentBrush}"/></DockPanel>
                        <TextBlock Text="项目" Margin="0,12,0,3" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/><TextBlock Text="{Binding Workspace.Session.ProjectPath}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="目标目录" Margin="0,12,0,3" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/><TextBlock Text="{Binding Workspace.LanguageHint}"/>
                        <TextBlock Text="命令参数" Margin="0,12,0,3" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/>
                        <Border Background="{DynamicResource CodeEditorSurfaceBrush}" CornerRadius="4" Padding="10,7"><TextBlock Text="{Binding Workspace.CommandPreview}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource DialogueTextBrush}" TextWrapping="Wrap"/></Border>
                        <TextBlock Text="预检额外追加 --count，不写入文件；正式生成完成后自动重新分析 tl 目录。" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SDK 路径" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Workspace.SdkPathDisplay}" Margin="12,0,8,0"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Workspace.SdkPathDisplay}"/>
                    <Button Grid.Column="2" Content="选择..." Command="{Binding Workspace.ChooseSdkCommand}"
                            Style="{StaticResource GhostButtonStyle}" Padding="10,5"/>
                    <Button Grid.Column="3" Content="清除" Command="{Binding Workspace.ClearSdkCommand}"
                            Style="{StaticResource GhostButtonStyle}" Padding="10,5" Margin="4,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Workspace.SdkSummary}"
                               Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="8,6,0,0"
                               HorizontalAlignment="Right" FontSize="11">
                        <Hyperlink NavigateUri="https://www.renpy.org/" RequestNavigate="OpenOfficialSdkPage"
                                   Foreground="{DynamicResource BrandAccentBrush}">下载 Ren’Py SDK（官网）</Hyperlink>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextSubtleBrush}"/>
                    <TextBlock Text="先执行预检，确认缺失数量后再生成翻译文件" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="HistoryPage" Grid.Row="1" Margin="0,18,0,0">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.IsHistoryPage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <ListView ItemsSource="{Binding Logs}" Background="{DynamicResource CodeEditorSurfaceBrush}" BorderThickness="0" Padding="10"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource ContentRowStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="11" Foreground="{DynamicResource BrandAccentBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource DialogueTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.HasLogs}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource TextSubtleBrush}"/>
                <TextBlock Text="尚无执行记录" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="预检和生成产生的命令、统计与错误会显示在这里" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
