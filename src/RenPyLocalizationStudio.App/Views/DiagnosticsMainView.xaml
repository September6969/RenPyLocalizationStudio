<UserControl x:Class="RenPyLocalizationStudio.App.Views.DiagnosticsMainView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Margin="16,8" Text="诊断" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ListView Grid.Row="1" ItemsSource="{Binding Workspace.Items}" SelectedItem="{Binding Workspace.SelectedItem}" MouseDoubleClick="List_MouseDoubleClick" PreviewKeyDown="List_PreviewKeyDown"
                  Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ContentRowStyle}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Border Background="{Binding Accent}"/><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Badge}" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}"/></Grid></DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
