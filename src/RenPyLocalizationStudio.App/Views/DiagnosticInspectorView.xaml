<UserControl x:Class="RenPyLocalizationStudio.App.Views.DiagnosticInspectorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="14,12"><TextBlock Text="诊断详情" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Diagnostic.Code}" Margin="0,16,0,5" Foreground="{DynamicResource BrandAccentBrush}" FontFamily="Cascadia Mono, Consolas"/><TextBlock Text="{Binding Diagnostic.Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Diagnostic.RelativePath}" Margin="0,12,0,0" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="{Binding Diagnostic.SuggestedAction}" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel>
</UserControl>
