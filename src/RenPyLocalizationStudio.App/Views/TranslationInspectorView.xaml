<UserControl x:Class="RenPyLocalizationStudio.App.Views.TranslationInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:behaviors="clr-namespace:RenPyLocalizationStudio.App.Behaviors"
             xmlns:selectors="clr-namespace:RenPyLocalizationStudio.App.Selectors">
    <UserControl.Resources>
        <DataTemplate x:Key="EmptyInspectorTemplate">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="30" Opacity="0.2"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="请在剧情流中选择节点以编辑译文" Margin="0,12,0,0" TextAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlowInspectorTemplate">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource DialogueTextBrush}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{Binding Details}" Margin="0,5,0,0" FontSize="11"
                           Foreground="{DynamicResource PathTextBrush}" TextWrapping="Wrap" />
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250">
                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="26" Opacity="0.2"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="这是流程节点，没有可编辑译文" Margin="0,10,0,0" TextAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TranslationEditorTemplate">
            <Grid DataContext="{Binding Owner}" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource DialogueTextBrush}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{Binding Location}" Margin="0,3,0,12" FontSize="11" Foreground="{DynamicResource PathTextBrush}" TextWrapping="Wrap" />
                
                <TextBlock Grid.Row="2" Text="原文" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                <Border Grid.Row="3" Background="{DynamicResource BackgroundLevel1}" CornerRadius="4" Padding="8,6">
                    <avalonEdit:TextEditor IsReadOnly="True" WordWrap="True" ShowLineNumbers="False"
                                           Background="Transparent" Foreground="{DynamicResource DialogueTextBrush}"
                                           FontFamily="Cascadia Code, Cascadia Mono, Consolas" FontSize="13"
                                           behaviors:AvalonEditBindingBehavior.BindableText="{Binding SourceText, Mode=OneWay}"
                                           behaviors:AvalonEditBindingBehavior.DocumentKey="{Binding DocumentKey}" />
                </Border>
                
                <ItemsControl Grid.Row="4" ItemsSource="{Binding PlaceholderTokens}" Margin="0,8" Tag="{Binding ElementName=TranslationEditor}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="Placeholder_Click" Focusable="False"
                                    Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Padding="6,3" Margin="0,0,4,4" ToolTip="在译文光标处插入；选中文字时替换选区，可用 Ctrl+Z 撤销"
                                    AutomationProperties.Name="{Binding}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource BrandAccentBrush}" FontFamily="Cascadia Code, Consolas" FontSize="11" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <TextBlock Grid.Row="5" Text="译文  ·  Ctrl+S 保存 / Alt+↑↓ 切换" TextWrapping="Wrap" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,4" />
                <Border Grid.Row="6" Background="{DynamicResource BackgroundLevel0}" BorderBrush="{DynamicResource BackgroundLevel1}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                    <avalonEdit:TextEditor x:Name="TranslationEditor" WordWrap="True" ShowLineNumbers="False"
                                           Background="Transparent" Foreground="{DynamicResource DialogueTextBrush}"
                                           FontFamily="{StaticResource StudioReadingFontFamily}" FontSize="15"
                                           behaviors:AvalonEditBindingBehavior.BindableText="{Binding TranslationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           behaviors:AvalonEditBindingBehavior.DocumentKey="{Binding DocumentKey}"
                                           behaviors:AvalonEditBindingBehavior.IsReadOnly="{Binding IsReadOnly}"
                                           behaviors:AvalonEditBindingBehavior.FocusRequest="{Binding FocusRequest}" />
                </Border>
                
                <StackPanel Grid.Row="7" Margin="0,8,0,0">
                    <Expander Header="{Binding SuggestionsHeading}" Foreground="{DynamicResource TextSubtleBrush}" Margin="0,0,0,8"
                              Visibility="{Binding HasSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Suggestions}" Tag="{Binding ElementName=TranslationEditor}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Click="Suggestion_Click" Focusable="False" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,3,0,0"
                                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            ToolTip="采用此译文，替换当前内容；可用 Ctrl+Z 撤销。请先核对语境。" AutomationProperties.Name="采用项目内已有译文">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                            <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger></Style.Triggers>
                                        </Style></Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Foreground="{DynamicResource DialogueTextBrush}" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                    <TextBlock Text="{Binding Impact}" Foreground="{DynamicResource BrandAccentBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource SemanticErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button Content="统一冲突译文" Command="{Binding UnifyConflictCommand}" Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,6"
                            Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <selectors:InspectorStateTemplateSelector x:Key="InspectorTemplateSelector"
                                                  EmptyTemplate="{StaticResource EmptyInspectorTemplate}"
                                                  FlowTemplate="{StaticResource FlowInspectorTemplate}"
                                                  TranslationEditorTemplate="{StaticResource TranslationEditorTemplate}" />
    </UserControl.Resources>
    <Grid Margin="14,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="翻译检查器" FontSize="15" FontWeight="SemiBold" />
        <ContentControl Grid.Row="1" Content="{Binding CurrentInspectorState}"
                        ContentTemplateSelector="{StaticResource InspectorTemplateSelector}" />
    </Grid>
</UserControl>
