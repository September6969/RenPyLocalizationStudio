<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RenPyLocalizationStudio.App.ViewModels"
                    xmlns:views="clr-namespace:RenPyLocalizationStudio.App.Views">
    <DataTemplate DataType="{x:Type vm:SimpleSidebarViewModel}"><views:SimpleSidebarView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TranslationSidebarViewModel}"><views:TranslationSidebarView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TranslationMainContentViewModel}"><views:TranslationMainView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TranslationInspectorViewModel}"><views:TranslationInspectorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TlMainContentViewModel}"><views:TlMainView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ArchiveMainContentViewModel}"><views:ArchiveMainView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UnrenToolViewModel}"><views:UnrenToolView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PrefixRenameToolViewModel}"><views:PrefixRenameToolView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ImageCompressionToolViewModel}"><views:ImageCompressionToolView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExtraTextMainContentViewModel}"><views:ExtraTextMainView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExtraTextInspectorViewModel}"><views:ExtraTextInspectorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsMainContentViewModel}"><views:DiagnosticsMainView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticInspectorViewModel}"><views:DiagnosticInspectorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PatchDocumentHostViewModel}"><views:PatchHostView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PatchInspectorViewModel}"><views:PatchInspectorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReplacementRulesDocumentViewModel}"><views:ReplacementRulesDocumentView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ZzzDocumentViewModel}"><views:ZzzDocumentView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiffDocumentViewModel}"><views:DiffDocumentView /></DataTemplate>
    <DataTemplate x:Key="ViewModeLabelTemplate"><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding}"/><Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="Flow"><Setter Property="Text" Value="剧情流"/></DataTrigger><DataTrigger Binding="{Binding}" Value="Strings"><Setter Property="Text" Value="字符串"/></DataTrigger><DataTrigger Binding="{Binding}" Value="Unbound"><Setter Property="Text" Value="未绑定"/></DataTrigger><DataTrigger Binding="{Binding}" Value="Bookmarks"><Setter Property="Text" Value="书签"/></DataTrigger><DataTrigger Binding="{Binding}" Value="Quality"><Setter Property="Text" Value="质量检查"/></DataTrigger>
    </Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
</ResourceDictionary>
