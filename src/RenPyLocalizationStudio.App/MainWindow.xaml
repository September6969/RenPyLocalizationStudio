<Window x:Class="RenPyLocalizationStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}" Width="1500" Height="880" MinWidth="720" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource BackgroundLevel0}" Foreground="{DynamicResource TextPrimaryBrush}"
        BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}"
        FontFamily="{StaticResource StudioUiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SizeChanged="OnWindowSizeChanged" StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing" Closed="OnWindowClosed"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MovePreviousTranslationCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveNextTranslationCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource BackgroundLevel1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,18,0" VerticalAlignment="Center">
                <Image Width="18" Height="18" Margin="0,0,10,0" Source="/Assets/renpy-localization-studio-mark.png"
                       ToolTip="RenPy Localization Studio" />
                <TextBlock x:Name="FullProductName" Text="RenPy Localization Studio" FontWeight="SemiBold" />
            </StackPanel>
            <Grid Grid.Column="1" Margin="10,4,16,4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE838;" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Session.ProjectName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.ProjectPath}" />
                </DockPanel>
                <Button Grid.Column="1" Content="更改..." Command="{Binding Session.ChooseProjectCommand}"
                        Style="{StaticResource GhostButtonStyle}" Margin="12,0,0,0" Padding="8,4" />
            </Grid>
            <StackPanel x:Name="LanguagePanel" Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="语言" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="110" Height="30" VerticalAlignment="Center" ItemsSource="{Binding Session.Languages}" SelectedItem="{Binding Session.Language, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="False" ToolTip="目标语言" />
            </StackPanel>
            <Grid Grid.Column="3" Margin="0,4,10,4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding Session.AnalyzeCommand}" Style="{StaticResource GhostButtonStyle}" ToolTip="分析当前项目" AutomationProperties.Name="分析项目"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" Margin="0,0,6,0"/><TextBlock Text="分析"/></StackPanel></Button>
                    <Button Command="{Binding Session.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0" ToolTip="保存译文 · Ctrl+S" AutomationProperties.Name="保存译文"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;" Margin="0,0,6,0"/><TextBlock Text="保存"/><TextBlock Text=" •" Visibility="{Binding Session.HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></Button>
                    <Button x:Name="SaveMenuButton" Style="{StaticResource GhostButtonStyle}" Padding="6,4" Click="OpenMenu_Click" AutomationProperties.Name="更多保存操作" ToolTip="更多保存操作"><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons"/>
                        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="保存并刷新流程注释" Command="{Binding Session.SaveWithAnnotationsCommand}"/>
                            <Separator/>
                            <MenuItem Header="强制覆盖外部修改…" Command="{Binding Session.ForceSaveCommand}" Foreground="{DynamicResource SemanticErrorBrush}" ToolTip="需再次确认，并保留 .rls.bak 备份"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Border x:Name="TaskCapsule" CornerRadius="12" Background="{DynamicResource BrandAccentSoftBrush}" Margin="4,0" Padding="6,0" Visibility="{Binding Tasks.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="处理中" VerticalAlignment="Center" ToolTip="{Binding Tasks.StatusMessage}"/><Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Command="{Binding Tasks.CancelCommand}" Style="{StaticResource GhostButtonStyle}" Padding="6,4" AutomationProperties.Name="取消当前任务" ToolTip="取消当前任务"/></StackPanel>
                    </Border>
                    <ToggleButton x:Name="MoreButton" Width="32" Style="{StaticResource IconToggleStyle}" FontFamily="Segoe Fluent Icons" FontSize="15" Content="&#xE713;" AutomationProperties.Name="设置" ToolTip="设置"/>
                </StackPanel>
                <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=MoreButton}" IsOpen="{Binding IsChecked, ElementName=MoreButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource FlyoutBorderStyle}"><StackPanel Width="224">
                        <TextBlock Text="设置" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,12"/>
                        <TextBlock Text="强调色" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Style="{StaticResource PresetColorButtonStyle}" Background="#D16BA5" Click="PresetColor_Click" Tag="#D16BA5" ToolTip="粉红" AutomationProperties.Name="粉红强调色"/>
                            <Button Style="{StaticResource PresetColorButtonStyle}" Background="#9B59B6" Click="PresetColor_Click" Tag="#9B59B6" ToolTip="紫色" AutomationProperties.Name="紫色强调色"/>
                            <Button Style="{StaticResource PresetColorButtonStyle}" Background="#3498DB" Click="PresetColor_Click" Tag="#3498DB" ToolTip="经典蓝" AutomationProperties.Name="蓝色强调色"/>
                            <Button Style="{StaticResource PresetColorButtonStyle}" Background="#1ABC9C" Click="PresetColor_Click" Tag="#1ABC9C" ToolTip="青绿" AutomationProperties.Name="青绿强调色"/>
                            <Button Style="{StaticResource PresetColorButtonStyle}" Background="#2ECC71" Click="PresetColor_Click" Tag="#2ECC71" ToolTip="翠绿" AutomationProperties.Name="翠绿强调色"/>
                            <Button Style="{StaticResource PresetColorButtonStyle}" Background="#E67E22" Click="PresetColor_Click" Tag="#E67E22" ToolTip="活力橙" AutomationProperties.Name="橙色强调色"/>
                            <Button Style="{StaticResource PresetColorButtonStyle}" Background="#E74C3C" Click="PresetColor_Click" Tag="#E74C3C" ToolTip="珊瑚红" AutomationProperties.Name="红色强调色"/>
                            <Button Style="{StaticResource PresetColorButtonStyle}" Background="#F1C40F" Click="PresetColor_Click" Tag="#F1C40F" ToolTip="金黄" AutomationProperties.Name="金黄强调色"/>
                        </WrapPanel>
                        <TextBlock Text="自定义颜色（#RRGGBB）" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,6"/>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="16" Height="16" CornerRadius="3" Background="{Binding AccentPreviewBrush}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource BoxedTextBoxStyle}" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自定义强调色"/>
                            <Button Grid.Column="2" Content="应用" Command="{Binding ApplyAccentCommand}" CommandParameter="{Binding AccentColor}" Style="{StaticResource GhostButtonStyle}" Padding="8,4"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="编辑" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"/>
                        <CheckBox Content="编辑后自动保存" IsChecked="{Binding Session.AutoSaveEnabled, Mode=TwoWay}" ToolTip="译文停止输入约 0.9 秒后自动写入，结构警告仍需确认。"/>
                    </StackPanel></Border>
                </Popup>
            </Grid>
            <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="OnMinimizeClick" Style="{StaticResource TitleBarButtonStyle}" ToolTip="最小化"
                        AutomationProperties.Name="最小化" FontFamily="Segoe Fluent Icons" FontSize="11" Content="&#xE921;" />
                <Button x:Name="MaximizeButton" Click="OnMaximizeRestoreClick" Style="{StaticResource TitleBarButtonStyle}" ToolTip="最大化"
                        AutomationProperties.Name="最大化" FontFamily="Segoe Fluent Icons" FontSize="10" Content="&#xE922;" />
                <Button Click="OnCloseClick" Style="{StaticResource TitleBarCloseButtonStyle}" ToolTip="关闭"
                        AutomationProperties.Name="关闭" FontFamily="Segoe Fluent Icons" FontSize="10" Content="&#xE8BB;" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/><ColumnDefinition x:Name="SidebarColumn" Width="260" MaxWidth="420"/><ColumnDefinition x:Name="SidebarDividerColumn" Width="6"/>
                <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="360"/><ColumnDefinition x:Name="InspectorDividerColumn" Width="6"/><ColumnDefinition x:Name="InspectorColumn" Width="360" MaxWidth="560"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="{DynamicResource BackgroundLevel1}">
                <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderSubtleBrush}" />
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Grid x:Name="ActivitySelectionIndicator" Width="48" Height="46" Opacity="0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="IndicatorTransform" Y="0" />
                        </Grid.RenderTransform>
                        <Border Width="3" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="1.5" Background="{DynamicResource BrandAccentBrush}" />
                        <Border Margin="6,3" CornerRadius="6" Background="{DynamicResource BrandAccentSoftBrush}" />
                    </Grid>
                </Canvas>
                <ListBox x:Name="ActivityBarList" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding CurrentWorkspace}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ActivityItemStyle}"
                         SelectionChanged="ActivityBarList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource SemanticErrorBrush}" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        MinWidth="16" Height="16" Margin="0,-7,-9,0" Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BackgroundLevel0}" Margin="3,0" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <ContentControl x:Name="SidebarHost" Grid.Column="1" Content="{Binding CurrentWorkspace.SidebarContent}"
                            Background="{DynamicResource BackgroundLevel1}" />
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Style="{StaticResource ColumnGridSplitterStyle}" DragCompleted="SidebarSplitter_DragCompleted" AutomationProperties.Name="调整导航宽度"/>
            <ContentControl x:Name="MainHost" Grid.Column="3" Content="{Binding CurrentWorkspace.MainContent}" Background="{DynamicResource BackgroundLevel0}" />
            <GridSplitter x:Name="InspectorSplitter" Grid.Column="4" Style="{StaticResource ColumnGridSplitterStyle}" DragCompleted="InspectorSplitter_DragCompleted" AutomationProperties.Name="调整检查器宽度"/>
            <ContentControl x:Name="InspectorHost" IsVisibleChanged="InspectorHost_IsVisibleChanged" Grid.Column="5" Content="{Binding CurrentWorkspace.InspectorContent}"
                            Background="{DynamicResource BackgroundLevel1}"
                            Visibility="{Binding CurrentWorkspace.IsInspectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Grid Grid.Row="2" Background="{DynamicResource BackgroundLevel1}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Tasks.StatusMessage}" Margin="10,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="1" Height="3" VerticalAlignment="Bottom" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource BrandAccentBrush}" IsIndeterminate="{Binding Tasks.IsBusy}"
                         AutomationProperties.Name="当前任务进度" />
            <Button Grid.Column="2" Content="快捷键" Style="{StaticResource GhostButtonStyle}" Padding="12,2" Click="OpenMenu_Click" AutomationProperties.Name="快捷键速查表">
                <Button.ContextMenu><ContextMenu><MenuItem Header="Ctrl+S　保存译文" IsEnabled="False"/><MenuItem Header="Ctrl+F　搜索并选中关键词" IsEnabled="False"/><MenuItem Header="F8　下一条待译" IsEnabled="False"/><MenuItem Header="Alt+↑ / ↓　切换可编辑译文" IsEnabled="False"/><MenuItem Header="Esc　清除搜索词" IsEnabled="False"/><MenuItem Header="Ctrl+Z　撤销编辑器输入" IsEnabled="False"/></ContextMenu></Button.ContextMenu>
            </Button>
        </Grid>
    </Grid>
</Window>
