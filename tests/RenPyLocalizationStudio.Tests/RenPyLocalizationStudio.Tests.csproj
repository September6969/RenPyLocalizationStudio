<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RenPyLocalizationStudio.Core\RenPyLocalizationStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\RenPyLocalizationStudio.App\RenPyLocalizationStudio.App.csproj" />
    <ProjectReference Include="..\RenPyLocalizationStudio.ProcessTestHelper\RenPyLocalizationStudio.ProcessTestHelper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyProcessTestHelper" AfterTargets="Build">
    <Copy SourceFiles="..\RenPyLocalizationStudio.ProcessTestHelper\bin\$(Configuration)\net10.0\RenPyLocalizationStudio.ProcessTestHelper.dll"
          DestinationFolder="$(OutputPath)" />
  </Target>

</Project>
